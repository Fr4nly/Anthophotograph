---
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import icons from "../assets/icons.svg?raw";
---


<!doctype html>
<html lang="en">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Antho-Photograph | Portafolio</title>

  <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}favicon.ico`} type="image/x-icon" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Carter+One&family=Expletus+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" defer></script>
</head>


<body
  class="bg-[#0b0d0f] text-[#f4f3ef] antialiased selection:bg-lime-300 selection:text-[#0b0d0f]">
  <!-- Sprite SVG inlineado (invisible) -->
  <div style="display:none" set:html={icons} />
  <div class="relative isolate min-h-screen overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-56 left-1/2 -z-10 h-150 w-5xl -translate-x-1/2 rounded-full bg-lime-500/25 blur-[120px]"
>
    </div>

    <!-- Contenido principal -->
    <Navbar />
    <slot />
  </div>
</body>

</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
