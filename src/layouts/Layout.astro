---
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import icons from "../assets/icons.svg?raw";

// Cada círculo: tamaño y color. La posición y el movimiento son aleatorios en cada carga.
const blobs = [
  'size-96 bg-lime-500/30',
  'size-[30rem] bg-lime-400/20',
  'size-80 bg-lime-600/30',
  'size-[26rem] bg-lime-300/15',
  'size-72 bg-lime-500/25',
  'size-[34rem] bg-lime-700/25',
  'size-64 bg-lime-400/25',
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Antho-Photograph | Portafolio</title>

    <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}favicon.ico`} type="image/x-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Carter+One&family=Expletus+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" defer></script>
  </head>

  <body
    class="bg-[#0b0d0f] text-[#f4f3ef] antialiased selection:bg-lime-300 selection:text-[#0b0d0f]"
  >
    <!-- Sprite SVG inlineado (invisible) -->
    <div style="display:none" set:html={icons} />

    <div class="relative isolate min-h-screen overflow-hidden">
             <!-- FONDO ANIMADO -->
      <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-[#0b0d0f] [contain-strict]">
        {blobs.map((cls) => (
          <div data-orbit class="absolute inset-0">
            <div data-blob class={`blob absolute rounded-full will-change-transform ${cls}`}></div>
          </div>
        ))}

        <!-- Viñeta para que el texto siga leyéndose bien -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(11,13,15,0.75)_100%)]"></div>
      </div>

      <!-- Contenido principal -->
      <Navbar />
      <slot />
    </div>

        <script>

          
      import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);
ScrollTrigger.config({ ignoreMobileResize: true }); // evita recálculos al mostrar/ocultar la barra del navegador

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const slow = reduceMotion ? 2 : 1; // con "reducir movimiento" va más lento, pero se mueve
      const rand = gsap.utils.random;

      document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((orbit) => {
        const blob = orbit.querySelector<HTMLElement>('[data-blob]')!;

        // Posición inicial aleatoria (el círculo queda centrado en ese punto)
        gsap.set(blob, {
          left: 0,
          top: 0,
          xPercent: -50,
          yPercent: -50,
          x: rand(0, window.innerWidth),
          y: rand(0, window.innerHeight),
        });

        // 1) Recorrido aleatorio: va de un punto a otro de la pantalla sin parar
        const wander = () =>
          gsap.to(blob, {
            x: rand(-0.1 * window.innerWidth, 1.1 * window.innerWidth),
            y: rand(-0.1 * window.innerHeight, 1.1 * window.innerHeight),
            scale: rand(0.6, 1.4),
            duration: rand(8, 2),
            ease: 'sine.inOut',
            onComplete: wander,
          });
        wander();

        // 2) Rotación: la capa gira alrededor de un punto cercano al centro,
        //    con sentido y velocidad aleatorios, curvando la trayectoria
        gsap.set(orbit, { transformOrigin: `${rand(35, 65)}% ${rand(35, 65)}%` });
        gsap.to(orbit, {
          rotation: rand(0, 1) > 0.5 ? 360 : -360,
          duration: rand(40, 90) * slow,
          ease: 'none',
          repeat: -1,
        });
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

    .blob {
    -webkit-mask-image: radial-gradient(closest-side, #000 25%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 25%, transparent 100%);
    backface-visibility: hidden;
  }
</style>