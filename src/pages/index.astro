---
import Layout from '../layouts/Layout.astro';
import Presentacion from '../components/presentacion.astro';
import Info from '../components/info.astro';
import Servicios from '../components/servicios.astro';
import Contacto from '../components/contacto.astro';
---

<Layout>
    <Presentacion />
    <Info />
    <Servicios />
    <Contacto />
</Layout>





<style is:global>
  /* Ocultar scrollbar en navegadores WebKit (Chrome, Safari, Edge) */
  html::-webkit-scrollbar {
    display: none;
  }
  
  /* Ocultar scrollbar en Firefox */
  html {
    scrollbar-width: none;
  }
  
  /* Ocultar scrollbar en IE/Edge legacy */
  html {
    -ms-overflow-style: none;
  }
</style>

<script>
	import { gsap } from 'gsap';

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!prefersReducedMotion) {
		gsap.from('[data-animate]', {
			opacity: 0,
			y: 22,
			duration: 0.8,
			stagger: 0.12,
			ease: 'power3.out',
			clearProps: 'all',
		});
	}
</script>
