---
import { readdirSync } from 'node:fs';

// ── Configuración de rutas (carpetas dentro de /public) ─────────────────────
const DIR_LG = 'frames';        // carpeta para escritorio
const DIR_SM = 'frames';        // carpeta para móvil (puede ser la misma)
const PREFIX = 'ezgif-frame-';  // cómo empieza el nombre de cada archivo
const EXT = 'webp';             // extensión
// ────────────────────────────────────────────────────────────────────────────

const FRAME_COUNT = readdirSync(`public/${DIR_LG}`).filter((f: string) =>
  f.toLowerCase().endsWith(`.${EXT}`)
).length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ... tu contenido actual de presentación (si lo tienes) ... -->

<section
  id="animacion"
  data-frame-scroll
  data-frame-count={FRAME_COUNT}
  data-dir-lg={DIR_LG}
  data-dir-sm={DIR_SM}
  data-prefix={PREFIX}
  data-ext={EXT}
  data-base={base}
  class="relative flex h-screen w-full items-center justify-center px-4"
>
  <!-- Tarjeta -->
  <div
    class="relative h-[70vh] w-full max-w-6xl overflow-hidden rounded-3xl border border-lime-700/60 bg-[#0b0d0f] shadow-2xl shadow-lime-900/30 ring-1 ring-lime-800"
  >
    <canvas class="absolute inset-0 h-full w-full"></canvas>

    <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-[#0b0d0f]/40 via-transparent to-transparent"></div>

    <!-- Loader -->
    <div
      data-loader
      class="absolute inset-0 z-10 grid place-items-center bg-[#0b0d0f] transition-opacity duration-500"
    >
      <p class="font-carter text-lime-400">
        Cargando <span data-progress>0</span>%
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollToPlugin);

  const DURATION = 3;      // segundos que tarda la animación completa
  const SCROLL_TIME = 1;   // segundos del desplazamiento entre secciones
  const GATE_STRIDE = 4;   // arranca cuando está cargado 1 de cada 4 frames (2 = arranque más tardío pero más fino)

  const section = document.querySelector<HTMLElement>('[data-frame-scroll]');

  if (section) {
    const canvas = section.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx = canvas.getContext('2d', { alpha: false })!;
    const loader = section.querySelector<HTMLElement>('[data-loader]')!;
    const progressText = section.querySelector<HTMLElement>('[data-progress]')!;
    const sobreMi = document.getElementById('sobre-mi');

    const frameCount = Number(section.dataset.frameCount);
    const last = frameCount - 1;
    const base = section.dataset.base ?? '';

    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const small = window.matchMedia('(max-width: 767px)').matches;
    const dir = small ? section.dataset.dirSm! : section.dataset.dirLg!;
    const prefix = section.dataset.prefix ?? 'frame-';
    const ext = section.dataset.ext ?? 'webp';
    const maxDpr = coarse ? 1.5 : 2;

    const frameSrc = (i: number) =>
      `${base}/${dir}/${prefix}${String(i + 1).padStart(3, '0')}.${ext}`;

    const images: HTMLImageElement[] = new Array(frameCount);
    const ready = new Uint8Array(frameCount); // 1 = frame cargado y decodificado
    const state = { frame: 0 };
    let lastDrawn = -1;

    /*
      Fases: loading (cargando) · idle (quieto) · play (frames corriendo) · scroll (desplazándose)
    */
    type Phase = 'loading' | 'idle' | 'play' | 'scroll';
    let phase: Phase = 'loading';
    let cooldownUntil = 0;
    let runId = 0;
    let frameTween: gsap.core.Tween | null = null;
    let scrollTween: gsap.core.Tween | null = null;

    // Posición donde empieza "Sobre mí" (se mide una vez, no en cada evento de scroll)
    let heroEnd = 0;
    const measure = () => {
      heroEnd = sobreMi
        ? sobreMi.getBoundingClientRect().top + window.scrollY
        : section.offsetHeight;
    };

    history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);

    function setPhase(p: Phase) {
      phase = p;
      syncIntercept();
    }

    /* ---------- Canvas ---------- */
    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
      const w = Math.round(canvas.clientWidth * dpr);
      const h = Math.round(canvas.clientHeight * dpr);
      if (w === canvas.width && h === canvas.height) return;
      canvas.width = w;
      canvas.height = h;
      render(true);
    }

    // Si el frame pedido aún no cargó, usa el anterior más cercano que sí esté listo
    function pickFrame(index: number) {
      for (let i = index; i >= 0; i--) if (ready[i]) return i;
      return -1;
    }

    function render(force = false) {
      const index = pickFrame(Math.round(state.frame));
      if (index < 0) return;
      if (!force && index === lastDrawn) return;

      const img = images[index];
      const scale = Math.max(canvas.width / img.naturalWidth, canvas.height / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;

      ctx.drawImage(img, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h);
      lastDrawn = index;
    }

    /* ---------- Animaciones cancelables ---------- */
    const isAtEnd = () => state.frame >= last - 0.5;
    const frameTime = (from: number, to: number) => (DURATION * Math.abs(to - from)) / last;

    const tweenFrames = (to: number, duration: number) =>
      new Promise<void>((resolve) => {
        frameTween?.kill();
        if (duration <= 0.01) {
          state.frame = to;
          render();
          resolve();
          return;
        }
        frameTween = gsap.to(state, {
          frame: to,
          duration,
          ease: 'none',
          onUpdate: () => render(),
          onComplete: resolve,
        });
      });

    const scrollToEl = (target: HTMLElement) =>
      new Promise<void>((resolve) => {
        scrollTween?.kill();
        scrollTween = gsap.to(window, {
          scrollTo: { y: target, autoKill: false },
          duration: SCROLL_TIME,
          ease: 'power2.inOut',
          onComplete: resolve,
        });
      });

    /* ---------- Navegación ---------- */
    async function navigate(id: string) {
      if (phase === 'loading') return;
      const target = document.getElementById(id);
      if (!target) return;

      const interrupting = phase !== 'idle';
      const myRun = ++runId;
      frameTween?.kill();
      scrollTween?.kill();

      const stale = () => myRun !== runId;
      const heroOffset = () => Math.abs(section!.getBoundingClientRect().top);

      if (id === 'animacion') {
        // Subir al hero (si estamos debajo) y reproducir la animación en reversa
        if (heroOffset() > 2) {
          setPhase('scroll');
          await scrollToEl(section!);
          if (stale()) return;
        }
        setPhase('play');
        await tweenFrames(0, frameTime(state.frame, 0));
        if (stale()) return;
      } else {
        // Sin nada en curso y animación sin completar: reproducirla antes de bajar
        if (!interrupting && !isAtEnd()) {
          if (heroOffset() > 2) {
            setPhase('scroll');
            await scrollToEl(section!);
            if (stale()) return;
          }
          setPhase('play');
          await tweenFrames(last, frameTime(state.frame, last));
          if (stale()) return;
        }

        // Si se interrumpió, ir directo a la sección; los frames terminan mientras se desplaza
        setPhase('scroll');
        if (!isAtEnd()) tweenFrames(last, Math.min(SCROLL_TIME, frameTime(state.frame, last)));
        await scrollToEl(target);
        if (stale()) return;

        frameTween?.kill();
        state.frame = last;
        render();
      }

      cooldownUntil = performance.now() + 350;
      setPhase('idle');
    }

    /* ---------- Intención de scroll ---------- */
    // Devuelve true si el evento debe bloquearse
    function handleIntent(dir: 'down' | 'up'): boolean {
      if (phase === 'loading') return true;

      // Animación en curso: scroll abajo la corta y muestra "Sobre mí"
      if (phase === 'play') {
        if (dir === 'down') navigate('sobre-mi');
        return true;
      }

      // Desplazándose entre secciones: ignorar el scroll del usuario
      if (phase === 'scroll') return true;
      if (performance.now() < cooldownUntil) return true;

      // Hero con la animación sin completar: scroll abajo => animar y bajar
      if (dir === 'down' && !isAtEnd() && window.scrollY < heroEnd - 4) {
        navigate('sobre-mi');
        return true;
      }

      // Borde superior de "Sobre mí": scroll arriba => volver y reproducir en reversa
      if (dir === 'up' && isAtEnd() && window.scrollY <= heroEnd + 4) {
        navigate('animacion');
        return true;
      }

      return false;
    }

    /*
      Los listeners que pueden bloquear el scroll (wheel / touchmove no pasivos) solo existen
      mientras hacen falta. Fuera de esas zonas el navegador scrollea de forma nativa y fluida.
    */
    let touchY = 0;
    let touchDone = false;

    function onWheel(e: WheelEvent) {
      if (e.ctrlKey || e.deltaY === 0) return; // Ctrl + rueda = zoom del navegador
      if (handleIntent(e.deltaY > 0 ? 'down' : 'up')) e.preventDefault();
    }

    function onTouchMove(e: TouchEvent) {
      if (touchDone) {
        e.preventDefault();
        return;
      }
      const dy = touchY - e.touches[0].clientY;
      if (Math.abs(dy) < 4) {
        if (phase !== 'idle') e.preventDefault();
        return;
      }
      if (handleIntent(dy > 0 ? 'down' : 'up')) {
        touchDone = true; // un gesto = una acción
        e.preventDefault();
      }
    }

    let interceptOn = false;

    function needsIntercept() {
      if (phase !== 'idle') return true;
      const y = window.scrollY;
      if (!isAtEnd()) return y < heroEnd - 4; // hero con la animación sin completar
      return y <= heroEnd + 160;              // cerca del borde superior de "Sobre mí"
    }

    function syncIntercept() {
      const need = needsIntercept();
      if (need === interceptOn) return;
      interceptOn = need;

      if (need) {
        window.addEventListener('wheel', onWheel, { passive: false });
        window.addEventListener('touchmove', onTouchMove, { passive: false });
      } else {
        window.removeEventListener('wheel', onWheel);
        window.removeEventListener('touchmove', onTouchMove);
      }
    }

    // Siempre activos, pero pasivos (no bloquean el scroll)
    window.addEventListener(
      'touchstart',
      (e) => {
        touchY = e.touches[0].clientY;
        touchDone = false;
      },
      { passive: true }
    );

    let scrollRaf = 0;
    window.addEventListener(
      'scroll',
      () => {
        if (scrollRaf) return;
        scrollRaf = requestAnimationFrame(() => {
          scrollRaf = 0;
          syncIntercept();
        });
      },
      { passive: true }
    );

    // Teclado
    window.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('input, textarea, select, [contenteditable="true"]')) return;

      const down = e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey);
      const up = e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey);
      if (!down && !up) return;

      if (handleIntent(down ? 'down' : 'up')) e.preventDefault();
    });

    // Botones del navbar (siempre pueden interrumpir lo que esté en curso)
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('href')!.slice(1);
        if (!id || !document.getElementById(id)) return;
        e.preventDefault();
        navigate(id);
      });
    });

    /* ---------- Precarga progresiva ---------- */
    // Orden de descarga: primero 1 de cada 8 (+ el último), luego 1 de cada 4, 2 y por último el resto.
    // Así hay una versión "gruesa" de la animación casi al instante y se va afinando sola.
    const order: number[] = [];
    const queued = new Uint8Array(frameCount);
    const enqueue = (i: number) => {
      if (!queued[i]) {
        queued[i] = 1;
        order.push(i);
      }
    };

    enqueue(0);
    enqueue(last);
    for (const stride of [8, 4, 2, 1]) {
      for (let i = 0; i < frameCount; i += stride) enqueue(i);
    }

    // Puerta de arranque: frames que deben estar listos antes de empezar
    const gate = new Set<number>([0, last]);
    for (let i = 0; i < frameCount; i += GATE_STRIDE) gate.add(i);
    let gateLeft = gate.size;
    let started = false;

    function start() {
      if (started) return;
      started = true;

      if (ready.some((v) => v === 1)) {
        loader.style.opacity = '0';
        loader.style.pointerEvents = 'none';
        render(true);
      } else {
        // Ningún frame cargó: se deja el aviso visible y la página sigue funcionando
        loader.querySelector('p')!.textContent =
          'No se encontraron los frames. Revisa la consola (F12).';
      }

      setPhase('idle');
      navigate('sobre-mi'); // animación de 3 s y bajada a "Sobre mí"
    }

    const concurrency = coarse ? 6 : 10;
    let cursor = 0;

    function loadNext() {
      if (cursor >= order.length) return;
      const i = order[cursor++];
      const img = new Image();
      img.decoding = 'async';

      const done = () => {
        ready[i] = img.naturalWidth > 0 ? 1 : 0;

        if (gate.has(i)) {
          gateLeft--;
          progressText.textContent = String(
            Math.round(((gate.size - gateLeft) / gate.size) * 100)
          );
          if (i === 0) render(true);
          if (gateLeft === 0) start();
        }
        loadNext();
      };

      img.onload = () => {
        // Decodifica antes de usarlo, para que dibujarlo no bloquee la animación
        img.decode().then(done, done);
      };
      img.onerror = () => {
        if (i === 0) console.error('No se pudo cargar el frame:', img.src);
        done();
      };
      img.src = frameSrc(i);
      images[i] = img;
    }

    for (let k = 0; k < concurrency; k++) loadNext();

    /* ---------- Inicio y resize ---------- */
    resizeCanvas();
    measure();
    syncIntercept();

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        resizeCanvas();
        measure();
        syncIntercept();
      });
    });

    window.addEventListener('load', () => {
      measure();
      syncIntercept();
    });
  }
</script>