---

---

<!-- Notch-style Navbar -->
<header
  id="main-header"
  class="font-carter fixed top-4 left-1/2 -translate-x-1/2 z-50 transition-all duration-500"
>
  <nav
    class="bg-lime-900/10 backdrop-blur-sm border border-lime-700 rounded-2xl p-2 shadow-xl ring-1 ring-lime-800"
  >
    <ul class="flex justify-center items-center gap-1 list-none p-0 m-0 h-11">
      <!-- Item 1: Animación -->
      <li class="relative transition-all duration-200 active:scale-90">
        <a
          href="#animacion"
          class="group flex items-center justify-center no-underline text-white/80 bg-lime-500/10 rounded-xl p-2.5 min-w-11 h-11 relative overflow-hidden transition-all duration-400 border border-transparent hover:bg-lime-950/15 hover:border-lime-500 hover:text-lime-500 hover:px-5 hover:min-w-max hover:shadow-lg hover:ring-1 hover:ring-white/20"
        >
          <!-- SVG Animación -->
          <svg width="23" height="23">
            <use href="#icon-animation"></use>
          </svg>

          <!-- Text -->
          <span
            id="aboutme"
            class="text-sm font-medium opacity-0 -translate-x-2.5 transition-all duration-400 whitespace-nowrap overflow-hidden max-w-0 group-hover:opacity-100 group-hover:translate-x-0 group-hover:max-w-25 group-hover:ml-2 relative z-10"
          >
            Animación
          </span>
        </a>
      </li>

      <!-- Item 2: Sobre mi -->
      <li class="relative transition-all duration-200 active:scale-90">
        <a
          href="#sobre-mi"
          class="group flex items-center justify-center no-underline text-white/80 bg-lime-500/10 rounded-xl p-2.5 min-w-11 h-11 relative overflow-hidden transition-all duration-400 border border-transparent hover:bg-lime-950/15 hover:border-lime-500 hover:text-lime-500 hover:px-5 hover:min-w-max hover:shadow-lg hover:ring-1 hover:ring-white/20"
        >
          <!-- SVG Sobre mi -->
          <svg width="25" height="25">
            <use href="#icon-user"></use>
          </svg>

          <!-- Text -->
          <span
            id="aboutme"
            class="text-sm font-medium opacity-0 -translate-x-2.5 transition-all duration-400 whitespace-nowrap overflow-hidden max-w-0 group-hover:opacity-100 group-hover:translate-x-0 group-hover:max-w-25 group-hover:ml-2 relative z-10"
          >
            Sobre mi
          </span>
        </a>
      </li>

      <!-- Item 3: Servicios -->
      <li class="relative transition-all duration-200 active:scale-90">
        <a
          href="#servicios"
          class="group flex items-center justify-center no-underline text-white/80 bg-lime-500/10 rounded-xl p-2.5 min-w-11 h-11 relative overflow-hidden transition-all duration-400 border border-transparent hover:bg-lime-950/15 hover:border-lime-500 hover:text-lime-500 hover:px-5 hover:min-w-max hover:shadow-lg hover:ring-1 hover:ring-white/20"
        >
          <!-- SVG Servicios -->
          <svg width="25" height="25">
            <use href="#icon-camera"></use>
          </svg>

          <span
            id="services"
            class="text-sm font-medium opacity-0 -translate-x-2.5 transition-all duration-400 whitespace-nowrap overflow-hidden max-w-0 group-hover:opacity-100 group-hover:translate-x-0 group-hover:max-w-25 group-hover:ml-2 relative z-10"
          >
            Servicios
          </span>
        </a>
      </li>

      <!-- Item 4: Contáctame -->
      <li class="relative transition-all duration-200 active:scale-90">
        <a
          href="#contactame"
          class="group flex items-center justify-center no-underline text-white/80 bg-lime-500/10 rounded-xl p-2.5 min-w-11 h-11 relative overflow-hidden transition-all duration-400 border border-transparent hover:bg-lime-950/15 hover:border-lime-500 hover:text-lime-500 hover:px-5 hover:min-w-max hover:shadow-lg hover:ring-1 hover:ring-white/20"
        >
          <!-- SVG Mail -->
          <svg width="25" height="25">
            <use href="#icon-mail"></use>
          </svg>

          <span
            id="contactme"
            class="text-sm font-medium opacity-0 -translate-x-2.5 transition-all duration-400 whitespace-nowrap overflow-hidden max-w-0 group-hover:opacity-100 group-hover:translate-x-0 group-hover:max-w-25 group-hover:ml-2 relative z-10"
          >
            Contáctame
          </span>
        </a>
      </li>
    </ul>
  </nav>
</header>
